# ─────────────────────────────────────────────────────────────────────────────
# Webx optional configuration. Copy to .env only if you need integrations.
# The recorded demo works with NO environment variables and NO API keys.
# ─────────────────────────────────────────────────────────────────────────────

# Browser / demo
WEBX_HEADLESS=false
WEBX_SLOWMO=280
WEBX_PACE=1.0
WEBX_DEMO_PORT=4173
WEBX_DASHBOARD_PORT=8000
# WEBX_CHROME_PATH=/opt/google/chrome/google-chrome

# Server-side voice (dashboard uses the browser's built-in voice by default)
WEBX_AUDIO=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
WEBX_ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional self-healing vision fallback for redesigned/external sites
OPENAI_API_KEY=
WEBX_OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
WEBX_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional AWS run memory (see infra/README.md)
WEBX_CLOUD_URL=
WEBX_CLOUD_TOKEN=

# Optional custom demo origin, e.g. if you serve demo/ elsewhere
# WEBX_DEMO_URL=http://127.0.0.1:4173
