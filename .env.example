# ─────────────────────────────────────────────────────────────────────────────
# AegisWeb optional configuration. Copy to .env only if you need integrations.
# The recorded demo works with NO environment variables and NO API keys.
# ─────────────────────────────────────────────────────────────────────────────

# Browser / demo
AEGIS_HEADLESS=false
AEGIS_SLOWMO=280
AEGIS_PACE=1.0
AEGIS_DEMO_PORT=4173
AEGIS_DASHBOARD_PORT=8000
# AEGIS_CHROME_PATH=/opt/google/chrome/google-chrome

# Server-side voice (dashboard uses the browser's built-in voice by default)
AEGIS_AUDIO=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
AEGIS_ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional self-healing vision fallback for redesigned/external sites
OPENAI_API_KEY=
AEGIS_OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
AEGIS_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional AWS run memory (see infra/README.md)
AEGIS_CLOUD_URL=
AEGIS_CLOUD_TOKEN=

# Optional custom demo origin, e.g. if you serve demo/ elsewhere
# AEGIS_DEMO_URL=http://127.0.0.1:4173
